# Light Story — root .env template
# Full reference: docs/decisions/ADR-001-gateway-url-fallback.md

# ── Supabase — Database & Auth ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://rwnzsmmfvsetfcnkjoxt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_URL=https://rwnzsmmfvsetfcnkjoxt.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_JWKS_URL=https://rwnzsmmfvsetfcnkjoxt.supabase.co/auth/v1/.well-known/jwks.json

# ── API Gateway (Unified Cloudflare Worker kv-worker) ─────────
NEXT_PUBLIC_GATEWAY_URL=https://kv-worker.hhhuygiau.workers.dev
NEXT_PUBLIC_GATEWAY_URL_PRODUCTION=https://kv-worker.hhhuygiau.workers.dev
NEXT_PUBLIC_SITE_URL=https://lightstory.app

# ── Internal Admin API auth (all three MUST match) ──────────
INTERNAL_ADMIN_SECRET=your-internal-admin-secret-32-chars
NEXT_PUBLIC_INTERNAL_ADMIN_SECRET=your-internal-admin-secret-32-chars
ADMIN_API_KEY=your-internal-admin-secret-32-chars

# ── Cloudflare R2 Storage ───────────────────────────────────
R2_ACCOUNT_ID=8ee8907819b5859d9543d68380ab6c1a
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://8ee8907819b5859d9543d68380ab6c1a.r2.cloudflarestorage.com
# Single bucket `comic` — covers/chapters separated by key prefix
NEXT_PUBLIC_R2_BUCKET_COVERS=comic
NEXT_PUBLIC_R2_BUCKET_CHAPTERS=comic

# ── Encryption (AES-256-GCM, ≥32 chars) ─────────────────────
NEXT_PUBLIC_ENC_KEY=your-32-char-encryption-key-here

# ── Backend / local-dev fallbacks ───────────────────────────
BACKEND_D1_SAAS_URL=http://localhost:8787/
BACKEND_D1_SAAS_ADMIN_KEY=
CF_API_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=8ee8907819b5859d9543d68380ab6c1a
ENABLE_LOCAL_DEV_FALLBACK=true

# ── Analytics ───────────────────────────────────────────────
CLOUDFLARE_ANALYTICS_WORKER_URL=https://kv-worker.hhhuygiau.workers.dev
