# Light Story — root .env template
# Copy to `.env`, fill values. Frontend keys are auto-imported into
# frontend/.env.local by frontend/scripts/import_root_env.mjs.
# Full reference: Instruction_create_key.md

# ── Supabase — Database & Auth ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_t_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_xxxxxxxxxxxxxxxxxxxx
# Fallbacks read by lib/supabase/server.ts (optional if NEXT_PUBLIC_* set)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWKS_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── API Gateway (unified gateway Worker kv-worker) ─────────
# Production order: NEXT_PUBLIC_GATEWAY_URL_PRODUCTION → NEXT_PUBLIC_GATEWAY_URL
# → https://kv-worker.hhhuygiau.workers.dev (see docs/decisions/ADR-001-gateway-url-fallback.md)
NEXT_PUBLIC_GATEWAY_URL=https://api.lightstory.app
NEXT_PUBLIC_GATEWAY_URL_PRODUCTION=https://kv-worker.hhhuygiau.workers.dev
# Canonical site URL (sitemap + OG metadataBase)
NEXT_PUBLIC_SITE_URL=https://lightstory.app

# ── Internal Admin API auth (all three MUST match) ──────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_ADMIN_SECRET=
NEXT_PUBLIC_INTERNAL_ADMIN_SECRET=
ADMIN_API_KEY=

# ── Cloudflare R2 Storage ───────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
# Single bucket `comic` — covers/chapters separated by key prefix
NEXT_PUBLIC_R2_BUCKET_COVERS=comic
NEXT_PUBLIC_R2_BUCKET_CHAPTERS=comic

# ── Encryption (AES-256-GCM, ≥32 chars) ─────────────────────
# Generate: openssl rand -base64 32
NEXT_PUBLIC_ENC_KEY=

# ── Backend / local-dev fallbacks ───────────────────────────
BACKEND_D1_SAAS_URL=http://localhost:8787/
BACKEND_D1_SAAS_ADMIN_KEY=
CF_API_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ENABLE_LOCAL_DEV_FALLBACK=true

# ── Analytics ───────────────────────────────────────────────
CLOUDFLARE_ANALYTICS_WORKER_URL=

# ── Sentry (production) ─────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_PUBLIC_KEY=
SENTRY_OTLP_TRACES_URL=
SENTRY_VERCEL_LOG_DRAIN_URL=
