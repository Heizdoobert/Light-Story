{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001 -H 0.0.0.0",
    "dev:clean": "node -e \"require('fs').rmSync('.next-dev',{recursive:true,force:true})\" && next dev -p 3002 -H 0.0.0.0",
    "dev:rescue": "node scripts/dev-rescue.mjs && next dev -p 3001 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3001 -H 0.0.0.0",
    "preview": "next start -p 3001 -H 0.0.0.0",
    "lint": "eslint . --max-warnings 140",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test auth-boundary",
    "test:e2e:ui": "playwright test --ui",
    "ci:verify": "npm run lint && npm run build && npm run test:run",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "env:add-service-key": "node ./scripts/add_service_key.mjs",
    "env:use-emulator": "node ./scripts/use_emulator.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/s3-request-presigner": "^3.1100.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@light-story/api-types": "file:../packages/api-types",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.101.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "dotenv": "^17.2.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "motion": "^13.0.0",
    "next": "^16.2.10",
    "radix-ui": "^1.6.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.8",
    "recharts": "^3.9.2",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.5.4",
    "eslint-config-next": "^16.2.12",
    "happy-dom": "^20.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.6"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "^1.29.1",
    "lightningcss-linux-x64-musl": "^1.29.1"
  }
}
