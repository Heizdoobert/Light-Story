        <!-- ================= 2. NETWORK & EDGE LAYER ================= -->
        <mxCell id="group_edge" value="2. CLOUDFLARE EDGE &amp; NETWORK LAYER" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#d97706;strokeWidth=2;fontColor=#fbbf24;fontStyle=1;fontSize=14;startSize=35;rounded=1;" vertex="1" parent="1">
