        <!-- ================= 3. API GATEWAY LAYER ================= -->
        <mxCell id="group_gateway" value="3. API GATEWAY (Cloudflare kv-worker)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#7c3aed;strokeWidth=2;fontColor=#c084fc;fontStyle=1;fontSize=14;startSize=35;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="170" width="410" height="920" as="geometry" />
        </mxCell>

        <mxCell id="gw_hono" value="&lt;b&gt;⚡ Hono API Gateway (`src/index.ts`)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• TypeScript Micro-Gateway Framework&lt;br/&gt;• Reverse Proxy to Supabase PostgREST&lt;br/&gt;• Global CORS &amp; Error Catch Sanitizer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#ffffff;align=left;spacingLeft=15;" vertex="1" parent="group_gateway">
          <mxGeometry x="25" y="60" width="360" height="110" as="geometry" />
        </mxCell>

        <mxCell id="gw_auth" value="&lt;b&gt;🔒 Web Crypto Auth (`auth.ts`)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• Edge JWT Claim Verification&lt;br/&gt;• `requireRouteAuthorization()` (Fast 401/403)&lt;br/&gt;• Injects DB Service Role on Verified Calls&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#f43f5e;strokeWidth=1.5;fontColor=#ffffff;align=left;spacingLeft=15;" vertex="1" parent="group_gateway">
          <mxGeometry x="25" y="190" width="360" height="110" as="geometry" />
        </mxCell>

        <mxCell id="gw_stories" value="&lt;b&gt;📚 Stories API (`routes/stories.ts`)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• `GET /stories` (Tag filter `?tag=X`, slug search)&lt;br/&gt;• `GET /stories/:id/chapters` (Manifest Cache)&lt;br/&gt;• `TAXONOMY_ENTITIES` (Genres, Tags, Authors)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#38bdf8;strokeWidth=1.5;fontColor=#ffffff;align=left;spacingLeft=15;" vertex="1" parent="group_gateway">
          <mxGeometry x="25" y="320" width="360" height="110" as="geometry" />
        </mxCell>

        <mxCell id="gw_presigner" value="&lt;b&gt;📤 R2 S3 Presigner (`routes/upload.ts`)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• Endpoint: `POST /api/upload/presigned`&lt;br/&gt;• Generates Scoped AWS S3 SigV4 PUT URLs&lt;br/&gt;• Sanitizes Keys (`covers/...`, `chapters/...`)&lt;br/&gt;• Direct Client ──▶ R2 Upload (Zero server load)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#4ade80;strokeWidth=2;fontColor=#4ade80;align=left;spacingLeft=15;" vertex="1" parent="group_gateway">
          <mxGeometry x="25" y="450" width="360" height="130" as="geometry" />
        </mxCell>

        <mxCell id="gw_infra" value="&lt;b&gt;📊 Superadmin Telemetry (`utils/infra.ts`)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• `GET /admin/analytics/dashboard` (Superadmin Gated)&lt;br/&gt;• R2 Bucket Object Count (13k objects)&lt;br/&gt;• Cloudflare Analytics Engine SQL &amp; Queue Stats&lt;br/&gt;• 20s Client Timeout for Cold Cache Resilience&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#e11d48;strokeWidth=1.5;fontColor=#ffffff;align=left;spacingLeft=15;" vertex="1" parent="group_gateway">
          <mxGeometry x="25" y="600" width="360" height="130" as="geometry" />
