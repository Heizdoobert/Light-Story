        <mxCell id="db_auth" value="&lt;b&gt;🔑 Supabase Auth Engine&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• GoTrue Auth &amp; PKCE Cookie Sessions&lt;br/&gt;• Custom Claims: `app_metadata.role`&lt;br/&gt;  (`superadmin`, `admin`, `employee`, `user`)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#f43f5e;strokeWidth=2;fontColor=#ffffff;align=left;spacingLeft=15;" vertex="1" parent="group_database">
