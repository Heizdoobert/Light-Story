        <mxCell id="e_read_6" value="[6] Stream WebP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#38bdf8;strokeWidth=2.5;fontColor=#38bdf8;fontSize=10;" edge="1" parent="1" source="c_reader" target="net_cdn">
          <mxGeometry relative="1" as="geometry">
