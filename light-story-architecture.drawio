        <!-- ================= 4. FRONTEND COMPUTE LAYER ================= -->
        <mxCell id="group_frontend" value="4. FRONTEND COMPUTE (Next.js 16 App Router)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#2563eb;strokeWidth=2;fontColor=#60a5fa;fontStyle=1;fontSize=14;startSize=35;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1395" y="170" width="420" height="920" as="geometry" />
