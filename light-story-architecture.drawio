        <mxCell id="fe_routes" value="&lt;b&gt;🚪 Pure Route Controllers (`src/app/`)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• 6-20 Lines per `page.tsx` (Architecture Rule 1)&lt;br/&gt;• Zero Inline State / Direct DB Calls / Effects&lt;br/&gt;• `(main)/comics/[slug]`, `/search`&lt;br/&gt;• `(admin)/admin/dashboard`, `/descriptions`, `/comics`&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#ffffff;align=left;spacingLeft=15;" vertex="1" parent="group_frontend">
          <mxGeometry x="25" y="60" width="370" height="110" as="geometry" />
        </mxCell>

        <mxCell id="fe_presenters" value="&lt;b&gt;🧠 Presenter Hook Pattern (`presenters/`)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• `useComicDetailPresenter`: Tag badges, cover fallback&lt;br/&gt;• `useReadChapterPresenter`: Auto-scroll cancel on scroll&lt;br/&gt;• `useAdminDashboardPresenter`: Superadmin telemetry state&lt;br/&gt;• `useSearchPresenter`: Multi-param debounced query&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#3b82f6;strokeWidth=2;fontColor=#ffffff;align=left;spacingLeft=15;" vertex="1" parent="group_frontend">
          <mxGeometry x="25" y="190" width="370" height="130" as="geometry" />
        </mxCell>

        <mxCell id="fe_actions" value="&lt;b&gt;⚡ Server Actions (`src/actions/`)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• Directives: `&#39;use server&#39;`&lt;br/&gt;• Standard Return: `ActionResult&lt;T&gt;`&lt;br/&gt;• Pipeline: `act()` wrapper with Zod Schema parsing&lt;br/&gt;• Actions: `createComic`, `updateComic`, `toggleBookmark`&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#fbbf24;strokeWidth=2;fontColor=#fbbf24;align=left;spacingLeft=15;" vertex="1" parent="group_frontend">
          <mxGeometry x="25" y="340" width="370" height="130" as="geometry" />
        </mxCell>

        <mxCell id="fe_middleware" value="&lt;b&gt;🛡️ Root Middleware (`middleware.ts`)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• `@supabase/ssr` Cookie Session Refresh&lt;br/&gt;• Fail-Closed Admin Redirect (`/admin/*` ──▶ `/login`)&lt;br/&gt;• CSP &amp; Security Header Injections&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#f43f5e;strokeWidth=1.5;fontColor=#ffffff;align=left;spacingLeft=15;" vertex="1" parent="group_frontend">
          <mxGeometry x="25" y="490" width="370" height="110" as="geometry" />
        </mxCell>

        <mxCell id="fe_components" value="&lt;b&gt;🎨 Pure Presentation JSX (`src/components/`)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• `reader/`: Zoom Canvas, Gesture Nav, Filmstrip&lt;br/&gt;• `admin/`: Dark-Theme Analytics Grid, Description Modal&lt;br/&gt;• `comics/`: Cover Cards, Tag Badges, Chapter Lists&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#64748b;strokeWidth=1.5;fontColor=#ffffff;align=left;spacingLeft=15;" vertex="1" parent="group_frontend">
          <mxGeometry x="25" y="620" width="370" height="120" as="geometry" />
        </mxCell>

        <mxCell id="fe_contexts" value="&lt;b&gt;GLOBAL CONTEXTS (`src/context/`)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px; color: #94a3b8;&quot;&gt;• `AuthContext.tsx` • `LanguageContext.tsx` (VI/EN) • `ThemeContext.tsx`&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#64748b;fontColor=#cbd5e1;align=center;" vertex="1" parent="group_frontend">
          <mxGeometry x="25" y="760" width="370" height="60" as="geometry" />
