        <!-- ================= 6. DATABASE & AUTH LAYER ================= -->
        <mxCell id="group_database" value="6. DATABASE &amp; AUTH (Supabase Postgres 15+)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#e11d48;strokeWidth=2;fontColor=#fb7185;fontStyle=1;fontSize=14;startSize=35;rounded=1;" vertex="1" parent="1">
