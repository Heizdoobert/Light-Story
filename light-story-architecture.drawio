        <mxCell id="e_upload_1" value="[1] Presign Req" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4ade80;strokeWidth=2.5;fontColor=#4ade80;fontSize=10;" edge="1" parent="1" source="c_staff" target="gw_presigner">
          <mxGeometry relative="1" as="geometry">
