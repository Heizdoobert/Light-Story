        <mxCell id="gw_bindings" value="&lt;b&gt;WRANGLER RUNTIME BINDINGS&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px; color: #94a3b8;&quot;&gt;• `APP_KV` • `COMIC_METADATA` • `R2_BUCKET` (comic)&lt;br/&gt;• `LIGHTSTORY_QUEUE` • `LIGHTSTORY_WORKFLOW` • `HYPERDRIVE`&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#64748b;fontColor=#cbd5e1;align=center;" vertex="1" parent="group_gateway">
          <mxGeometry x="25" y="750" width="360" height="80" as="geometry" />
