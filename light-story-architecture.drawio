        <!-- ================= MASTER BANNER ================= -->
        <mxCell id="blueprint_title" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px; color: #ffffff;&quot;&gt;LIGHT-STORY SYSTEM ARCHITECTURE &amp; DATA FLOW BLUEPRINT&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 13px; color: #94a3b8;&quot;&gt;Decoupled Fullstack Topology: Next.js 16 (App Router) • Cloudflare Workers (kv-worker) • Cloudflare R2 • Supabase Postgres 15+ &amp; RLS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#3b82f6;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
