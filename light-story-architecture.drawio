        <mxCell id="net_dns" value="&lt;b&gt;🌐 Anycast DNS &amp; SSL/TLS&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• Global Anycast Network (300+ PoPs)&lt;br/&gt;• 0-RTT TLS 1.3 Termination&lt;br/&gt;• Automated Layer 3/4/7 DDoS Protection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#fbbf24;strokeWidth=1.5;fontColor=#ffffff;align=left;spacingLeft=15;" vertex="1" parent="group_edge">
