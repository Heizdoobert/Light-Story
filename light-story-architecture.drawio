        <!-- Write Path Edge 2: Staff -> Direct R2 PUT -->
        <mxCell id="e_upload_2" value="[2] Direct S3 SigV4 PUT WebP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4ade80;strokeWidth=2.5;fontColor=#4ade80;fontSize=10;" edge="1" parent="1" source="c_staff" target="st_r2">
          <mxGeometry relative="1" as="geometry">
