        <!-- ================= 5. STORAGE & CACHE LAYER ================= -->
        <mxCell id="group_storage" value="5. STORAGE &amp; DISTRIBUTED CACHE" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#059669;strokeWidth=2;fontColor=#34d399;fontStyle=1;fontSize=14;startSize=35;rounded=1;" vertex="1" parent="1">
