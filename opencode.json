{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "npm": "@ai-sdk/openai"
    },
    "codex": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://api.openai.com/v1",
        "apiKey": "${OPENCODE_API_KEY}"
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "subagent_depth": 2,
  "max_schema_depth": 50,
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated",
        "--executablePath",
        "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe"
      ],
      "enabled": true
    }
  }
}
