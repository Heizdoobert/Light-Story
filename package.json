{
  "name": "light-story-workspace",
  "version": "1.5.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend",
    "workers/*",
    "backend-supabase"
  ],
  "scripts": {
    "test": "npm --prefix frontend run test:run && npm --prefix workers/kv-worker test",
    "ci:full": "npm --prefix packages/ui run test:unit && npm --prefix frontend run test:security && npm --prefix frontend run test:e2e:comic-upload",

    "prepush:security": "npm audit --audit-level=high && echo 'Security check passed' || (echo 'Security issues detected – aborting push.' && exit 1)",
    "prepare": "husky install || true",
    "agent:cli": "python3 -m agent_system",
    "agent:mcp": "python3 -m agent_system.cli.main mcp --root .",
    "dev": "npm --prefix frontend run dev",
    "dev:gateway": "npx wrangler dev --port 8787 --remote --config workers/kv-worker/wrangler.dev.jsonc",
    "dev:all": "concurrently -n fe,gw \"npm run dev\" \"npm run dev:gateway\"",
    "build": "npm --prefix frontend run build",
    "check": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "preview": "npm --prefix frontend run preview",
    "deploy": "wrangler deploy --config workers/kv-worker/wrangler.jsonc",
    "test:run": "npm --prefix frontend run test:run",
    "doctor": "node scripts/doctor.mjs",
    "healthcheck": "node scripts/doctor.mjs",
    "postinstall": "node -e \"try{require('fs').rmSync('node_modules/light-story-workspace',{recursive:true,force:true})}catch(e){}\"",
    "generate:types": "npm --prefix packages/api-types run generate",
    "lint:api": "npx --yes swagger-cli validate packages/api-types/openapi.yaml",
    "docker:build": "docker compose --env-file docker-local.env down --rmi all --volumes && docker system prune -af --volumes && docker compose --env-file docker-local.env build --no-cache && docker compose --env-file docker-local.env up -d",
    "docker:up": "docker compose --env-file docker-local.env up -d",
    "docker:local": "powershell -ExecutionPolicy Bypass -File docker-local.ps1",
    "docker:local:emulator": "powershell -ExecutionPolicy Bypass -File docker-local.ps1 -Local",
    "docker:local:fast": "powershell -ExecutionPolicy Bypass -File docker-local.ps1 -Fast",
    "docker:rebuild": "npm run docker:build",
    "cocoindex": "npm --prefix frontend run cocoindex"
  },
  "devDependencies": {
    "vite": "^6.4.5",
    "@cloudflare/workers-types": "^4.20260625.1",
    "@supabase/supabase-js": "^2.106.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^9.2.4",
    "csstype": "^3.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "undici-types": "^8.12.3",
    "vitest": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "wrangler": "4.105.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.0",
    "@supabase/cli-linux-x64": "^2.109.1",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@typescript/typescript-linux-x64": "7.0.2"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "shell-quote": "1.12.0",
    "proxy-addr": "2.0.8",
    "tinypool": "2.2.0",
    "tmp": "0.2.7",
    "fast-uri": "4.2.3",
    "body-parser": "2.3.0",
    "postcss": "8.5.25",
    "hono": "4.13.16",
    "js-yaml": "4.3.2",
    "undici": "7.30.1",
    "happy-dom": "^21.0.4",
    "sharp": "0.35.5",
    "@hono/node-server": "2.1.5",
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.5"
    },
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.1.5"
    }
  },
  "resolutions": {
    "tinypool": "2.2.0",
    "tmp": "0.2.7"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260625.1": true
  }
}
