{
  "name": "light-story-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend",
    "workers/*",
    "backend-supabase"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:gateway": "npx wrangler dev --port 8787 --remote --config workers/kv-worker/wrangler.jsonc",
    "dev:all": "concurrently -n fe,gw \"npm run dev\" \"npm run dev:gateway\"",
    "build": "npm --prefix frontend run build",
    "check": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview",
    "deploy": "wrangler deploy --config workers/kv-worker/wrangler.jsonc",
    "test:run": "npm --prefix frontend run test:run",
    "generate:types": "npm --prefix packages/api-types run generate",
    "docker:build": "docker compose down --rmi all --volumes && docker system prune -af --volumes && docker compose build --no-cache && docker compose up -d",
    "docker:up": "docker compose up -d",
    "docker:rebuild": "npm run docker:build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260625.1",
    "@supabase/supabase-js": "^2.106.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "wrangler": "4.105.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.0",
    "@supabase/cli-linux-x64": "^2.109.1",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3"
  },
  "overrides": {
    "shell-quote": "1.10.0",
    "fast-uri": "4.1.2",
    "body-parser": "2.3.0",
    "postcss": "8.5.25",
    "hono": "4.12.34",
    "undici": "7.29.0",
    "sharp": "0.35.3",
    "@hono/node-server": "2.0.11",
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    },
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.0.11"
    }
  },
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260625.1": true
  }
}
