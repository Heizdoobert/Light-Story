# PostgreSQL connection string (Supabase direct connection or local Postgres)
# Example: postgres://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Or local: postgres://postgres:postgres@localhost:5432/postgres
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/postgres

# LLM & Embedding provider configuration (LiteLLM handles standard prefixes)
# For OpenAI:
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# For Gemini (Alternative):
# GEMINI_API_KEY=your-gemini-api-key
# LLM_MODEL=gemini/gemini-1.5-flash
# EMBEDDING_MODEL=gemini/text-embedding-004

# Directory containing markdown/PDF documents to index
SOURCE_DOCS_DIR=./data
