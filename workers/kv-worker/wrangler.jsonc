{
  "name": "kv-worker",
  "main": "src/index.ts",
  "account_id": "8ee8907819b5859d9543d68380ab6c1a",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "minify": true,
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "comic"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://rwnzsmmfvsetfcnkjoxt.supabase.co",
    "ALLOWED_ORIGIN_SUFFIXES": "lightstory.app",
    "SUPABASE_JWKS_URL": "https://rwnzsmmfvsetfcnkjoxt.supabase.co/auth/v1/.well-known/jwks.json",
    "CLOUDFLARE_ACCOUNT_ID": "8ee8907819b5859d9543d68380ab6c1a",
    "GDRIVE_FALLBACK_URL": ""
  },
  "kv_namespaces": [
    {
      "binding": "APP_KV",
      "id": "478819101386406ab6d14b2d45d48c45"
    },
    {
      "binding": "COMIC_METADATA",
      "id": "be1064d42006414fb6cb67f1e337a9c9"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "LIGHTSTORY_QUEUE",
        "queue": "lightstory-queue"
      }
    ],
    "consumers": [
      {
        "queue": "lightstory-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "lightstory-dlq"
      }
    ]
  },
  "workflows": [
    {
      "name": "lightstory-workflow",
      "binding": "LIGHTSTORY_WORKFLOW",
      "class_name": "LightStoryWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTER_DO",
        "class_name": "CounterDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CounterDO"]
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "5a02e4b848144795b7532d1b6140660b",
      "localConnectionString": "postgres://postgres:password@localhost:5432/postgres"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS_DATA",
      "dataset": "lightstory_analytics"
    }
  ],
  "triggers": {
    "crons": ["0 2 * * *"]
  },
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "api.lightstory.app/*",
          "zone_name": "lightstory.app"
        }
      ]
    },
    "staging": {
      "routes": [
        {
          "pattern": "api-staging.lightstory.app/*",
          "zone_name": "lightstory.app"
        }
      ]
    }
  }
}
