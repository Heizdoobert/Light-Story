{
  "name": "kv-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "lightstory-assets"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://rwnzsmmfvsetfcnkjoxt.supabase.co",
    "SUPABASE_JWKS_URL": "https://rwnzsmmfvsetfcnkjoxt.supabase.co/auth/v1/.well-known/jwks.json"
  },
  "kv_namespaces": [
    {
      "binding": "APP_KV",
      "id": "bde008a5d4b54e53af699933f366dabe"
    },
    {
      "binding": "COMIC_METADATA",
      "id": "dcedc9ebb0d846838d4be79df5a2698c"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "LIGHTSTORY_QUEUE",
        "queue": "lightstory-queue"
      }
    ],
    "consumers": [
      {
        "queue": "lightstory-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "lightstory-queue-dlq"
      }
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "e34fbae0b4a94fd48007b217837c00cb",
      "localConnectionString": "postgres://postgres:password@localhost:5432/postgres"
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS_DATA",
      "dataset": "analytic"
    }
  ],
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "api.lightstory.app/*",
          "zone_name": "lightstory.app"
        }
      ]
    },
    "staging": {
      "routes": [
        {
          "pattern": "api-staging.lightstory.app/*",
          "zone_name": "lightstory.app"
        }
      ]
    }
  }
}
