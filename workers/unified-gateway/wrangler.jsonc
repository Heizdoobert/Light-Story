{
  "name": "unified-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "lightstory-assets"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://xgtlrztskoomimvfpdoy.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhndGxyenRza29vbWltdmZwZG95Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg5NDAzOTUsImV4cCI6MjA5NDUxNjM5NX0.wLQjtFsLuXmCbvKMFdukK3fk3brft-mjZb4dz1QUH2Q",
    "SUPABASE_SERVICE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhndGxyenRza29vbWltdmZwZG95Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3ODk0MDM5NSwiZXhwIjoyMDk0NTE2Mzk1fQ.J8c7_vHFFwHN73C2WmTuAFJ_YNs4c7e88WU7yvqlwDY",
    "SUPABASE_SERVICE_ROLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhndGxyenRza29vbWltdmZwZG95Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3ODk0MDM5NSwiZXhwIjoyMDk0NTE2Mzk1fQ.J8c7_vHFFwHN73C2WmTuAFJ_YNs4c7e88WU7yvqlwDY",
    "SUPABASE_JWKS_URL": "https://xgtlrztskoomimvfpdoy.supabase.co/auth/v1/.well-known/jwks.json"
  },
  "kv_namespaces": [
    {
      "binding": "APP_KV",
      "id": "bde008a5d4b54e53af699933f366dabe"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "LIGHTSTORY_QUEUE",
        "queue": "lightstory-queue"
      }
    ],
    "consumers": [
      {
        "queue": "lightstory-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "lightstory-queue-dlq"
      }
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "e34fbae0b4a94fd48007b217837c00cb",
      "localConnectionString": "postgresql://postgres.bfgrmdqpqbhjgbdtgkgu:Fillbert%401103@aws-0-us-west-1.pooler.supabase.com:5432/postgres"
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS_DATA",
      "dataset": "analytic"
    }
  ],
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "api.lightstory.app/*",
          "zone_name": "lightstory.app"
        }
      ]
    },
    "staging": {
      "routes": [
        {
          "pattern": "api-staging.lightstory.app/*",
          "zone_name": "lightstory.app"
        }
      ]
    }
  }
}
